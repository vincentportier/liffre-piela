---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Merci d'avoir contacté Liffré-Piéla">
  <div class="thanks">
    <div class="no-banner">
      <h1>
        Merci d'avoir contacté Liffré Piéla, nous reviendrons vers vous dès que possible.
      </h1>
    </div>
    <a href="/" class="button home-button">Retourner à l'accueil</a>
  </div>
</Layout>

<style>
  .thanks {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .home-button {
    margin-top: 50px;
  }
</style>
