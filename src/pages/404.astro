---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Page introuvable - Liffré-Piéla">
  <div class="notfound no-banner">
    <p class="code">404</p>
    <h1>Oups, voilà qui n'était pas prévu…</h1>
    <p class="lead">La page que vous recherchez semble introuvable.</p>
    <div class="actions">
      <a href="/" class="button">Retour à l'accueil</a>
      <a href="/blog" class="button button-ghost">Voir les articles</a>
    </div>
  </div>
</Layout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 48ch;
    margin: 0 auto;
    padding-bottom: var(--space-8);
  }
  .code {
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 12vw, 6rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--brand-200);
    margin: 0 0 var(--space-3);
  }
  .notfound h1 {
    margin: 0 0 var(--space-3);
    font-size: var(--fz-h2);
  }
  .lead {
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
</style>
